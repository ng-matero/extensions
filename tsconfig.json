{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "useDefineForClassFields": false,
    "paths": {
      "@ng-matero/extensions": [
        "./projects/extensions"
      ],
      "@ng-matero/extensions/*": [
        "./projects/extensions/*"
      ],
      "@ng-matero/extensions-moment-adapter": [
        "./projects/extensions-moment-adapter"
      ],
      "@ng-matero/extensions-moment-adapter/*": [
        "./projects/extensions-moment-adapter/*"
      ],
      "@ng-matero/extensions-luxon-adapter": [
        "./projects/extensions-luxon-adapter"
      ],
      "@ng-matero/extensions-luxon-adapter/*": [
        "./projects/extensions-luxon-adapter/*"
      ],
      "@ng-matero/extensions-date-fns-adapter": [
        "./projects/extensions-date-fns-adapter"
      ],
      "@ng-matero/extensions-date-fns-adapter/*": [
        "./projects/extensions-date-fns-adapter/*"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
